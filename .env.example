# 이 파일을 복사해서 이름을 .env 로 바꾸고 값을 채우세요. (.env 는 git에 안 올라감)

# 넥슨 오픈 API 키 — openapi.nexon.com 로그인 → 애플리케이션 등록 → FC온라인 선택 → 개발 단계 키
NEXON_API_KEY=

# 내 FC온라인 닉네임
FC_NICKNAME=

# 모을 경기 모드 (쉼표로 여러 개) — 50 공식경기, 52 감독모드, 40 친선, 60 공식 친선
FC_MATCHTYPES=50

# 모드별로 최근 몇 경기까지 모을지
FC_MAX_MATCHES=300

# 한 번 실행할 때 쓸 최대 호출 수 (개발 키 하루 한도 1,000회 — 여유를 둠)
FC_CALL_BUDGET=900
